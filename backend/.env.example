# Server
PORT=8080

# JWT
# NOTE: 반드시 설정 필요 (미설정 시 로그인/토큰 발급이 500으로 실패합니다)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# CORS (comma-separated)
ALLOWED_ORIGINS=https://www.codeai.co.kr,https://codeai.co.kr,http://localhost:3000,http://127.0.0.1:3000

# Public API base (optional) - 알림톡/문자 링크 생성에 사용
API_PUBLIC_BASE=https://api.codeai.co.kr

# MySQL (NCP)
DB_HOST=db-3or502.vpc-cdb.ntruss.com
DB_PORT=3306
DB_USER=FLOWNCO
DB_PASS=flownco-1211
DB_NAME=codeai-student

# Optional
NODE_ENV=production

# =========================================
# Aligo(알림톡/문자) - 템플릿 준비 전에는 비워둬도 됩니다.
# =========================================

ALIGO_ENABLED=false
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDERKEY=
ALIGO_SENDER_PHONE=

# 알림톡 템플릿 코드(이벤트별)
ALIGO_TPL_WEEKLY_REPORT=UF_5398
ALIGO_TPL_WEEKLY=UF_5398
ALIGO_TPL_APPLY=UF_5399
ALIGO_TPL_INSTRUCTOR_APPLY=
ALIGO_TPL_STUDENT_APPLY_PARENT=UF_5399
ALIGO_TPL_STUDENT_APPLY_ADMIN=
ALIGO_TPL_STUDENT_APPLY_INSTRUCTOR=

# 템플릿 변수
